\ProvidesPackage{tw-academic}

\usepackage{fontspec}
\usepackage{xeCJK}
\usepackage{xurl}
\setCJKmainfont{宋體-繁}[ItalicFont=宋體-繁]

\usepackage[style=apa,backend=biber]{biblatex}
\renewcommand{\bibopenparen}{（}
\renewcommand{\bibcloseparen}{）}
\DefineBibliographyStrings{english}{%
  andothers={等人},%
  references={參考文獻},%
}
\renewcommand*{\nameyeardelim}{，}

% layout
\usepackage[top=2.5cm, bottom=2.5cm, left=2.5cm, right=2.5cm]{geometry}
\usepackage{setspace}
\onehalfspacing

\usepackage{parskip}
\setlength{\parskip}{12pt}

\usepackage{zhnumber}
\usepackage{titlesec}
\usepackage{titletoc}

\renewcommand{\thesection}{\zhnumber{\arabic{section}}}
\renewcommand{\thesubsection}{\zhnumber{\arabic{subsection}}}
\renewcommand{\thesubsubsection}{\zhnumber{\arabic{subsubsection}}}

% 第X章 研究分析
\titleformat{\section}
  {\fontsize{14}{16}\selectfont\bfseries}
  {第\thesection 章}
  {1em}{}

% 第X節 勞動技能的編碼邊界
\titleformat{\subsection}
  {\fontsize{14}{16}\selectfont\bfseries}
  {第\thesubsection 節}
  {1em}{}

% （一）勞動與知識的可編碼性
\titleformat{\subsubsection}
  {\fontsize{14}{16}\selectfont\bfseries}
  {（\thesubsubsection）}
  {0.5em}{}

\titlespacing*{\section}{0pt}{12pt}{12pt}
\titlespacing*{\subsection}{0pt}{12pt}{12pt}
\titlespacing*{\subsubsection}{0pt}{12pt}{12pt}

% 圖 1-2 style captions (section-local counter, Arabic section number)
\usepackage{graphicx}
\usepackage{chngcntr}
\counterwithin{figure}{section}
\renewcommand{\thefigure}{\arabic{section}-\arabic{figure}}
\renewcommand{\figurename}{圖}
\renewcommand{\tablename}{表}
\renewcommand{\thetable}{\zhnumber{\arabic{table}}}
\setlength{\belowcaptionskip}{12pt}

\renewcommand{\contentsname}{目錄}

\setcounter{tocdepth}{2}

\titlecontents{section}
  [0em]{}
  {第\thecontentslabel 章\quad}
  {}
  {\titlerule*[0.5pc]{.}\contentspage}

\titlecontents{subsection}
  [2em]{}
  {第\thecontentslabel 節\quad}
  {}
  {\titlerule*[0.5pc]{.}\contentspage}
